{%- comment -%}
  Gallery: dark intro banner, category filter tabs, photo grid and a full-screen lightbox (reference: /gallery).
  Each photo block uses the image picked in the editor, or falls back to a file of that name in Settings → Files (e.g. garment-01.jpg).
{%- endcomment -%}
{%- liquid
  assign photos = section.blocks | where: 'type', 'photo'
  assign cats = ''
  for block in photos
    assign c = block.settings.category | strip
    unless cats contains c
      if cats == ''
        assign cats = c
      else
        assign cats = cats | append: ',' | append: c
      endif
    endunless
  endfor
  assign cat_list = cats | split: ','
-%}
<div class="jt" data-jt-gallery-page>
  <section class="jt:bg-charcoal jt:pt-32 jt:pb-16 jt:lg:pt-40 jt:lg:pb-20">
    <div class="jt:mx-auto jt:max-w-7xl jt:px-6 jt:lg:px-12">
      <span class="jt:mb-4 jt:block jt:text-[11px] jt:uppercase jt:tracking-[0.3em] jt:text-cream/40">{{ section.settings.eyebrow }}</span>
      <h1 class="jt:mb-6 jt:font-cinzel jt:text-4xl jt:leading-tight jt:text-cream jt:lg:text-6xl">{{ section.settings.heading }}</h1>
      <p class="jt:max-w-2xl jt:text-sm jt:leading-relaxed jt:text-cream/50">{{ section.settings.text }}</p>
    </div>
  </section>

  <section class="jt:py-16 jt:lg:py-24">
    <div class="jt:mx-auto jt:max-w-7xl jt:px-6 jt:lg:px-12">
      {%- if cat_list.size > 1 -%}
        <div class="jt-scrollless jt:mb-10 jt:flex jt:gap-3 jt:overflow-x-auto jt:pb-2" role="tablist">
          <button type="button" data-jt-gfilter="all" class="jt-gfilter is-active jt:shrink-0 jt:border jt:px-5 jt:py-2.5 jt:text-[10px] jt:uppercase jt:tracking-[0.2em] jt:transition-colors jt:duration-300">All</button>
          {%- for c in cat_list -%}
            <button type="button" data-jt-gfilter="{{ c }}" class="jt-gfilter jt:shrink-0 jt:border jt:px-5 jt:py-2.5 jt:text-[10px] jt:uppercase jt:tracking-[0.2em] jt:transition-colors jt:duration-300">{{ c | replace: '-', ' ' | capitalize }}</button>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="jt:grid jt:grid-cols-2 jt:gap-1.5 jt:sm:grid-cols-3 jt:sm:gap-2 jt:lg:grid-cols-4">
        {%- for block in photos -%}
          {%- liquid
            assign img = block.settings.image
            if img == blank and block.settings.filename != blank
              assign img = images[block.settings.filename]
            endif
            assign alt_text = block.settings.alt | default: 'Photo'
            assign img_loading = 'lazy'
            if forloop.index <= 4
              assign img_loading = 'eager'
            endif
          -%}
          {%- assign use_asset = false -%}
          {%- if img == blank and block.settings.filename contains 'jt-' -%}{%- assign use_asset = true -%}{%- endif -%}
          {%- if img != blank or use_asset -%}
            {%- if use_asset -%}
              {%- assign full_src = block.settings.filename | asset_url -%}
            {%- else -%}
              {%- assign full_src = img | image_url: width: 1600 -%}
            {%- endif -%}
            <button type="button" data-jt-gitem data-cat="{{ block.settings.category | strip }}" data-full="{{ full_src }}" data-alt="{{ alt_text | escape }}" aria-label="Open photo: {{ alt_text | escape }}" class="jt-reveal jt:group jt:relative jt:aspect-[3/4] jt:cursor-zoom-in jt:overflow-hidden jt:bg-charcoal/5" style="--jt-delay: {{ forloop.index0 | modulo: 8 | times: 0.04 }}s" {{ block.shopify_attributes }}>
              {%- if use_asset -%}
                <img src="{{ block.settings.filename | asset_url }}" alt="{{ alt_text | escape }}" class="jt:absolute jt:inset-0 jt:h-full jt:w-full jt:object-cover jt:transition-transform jt:duration-500 jt:group-hover:scale-105" loading="{{ img_loading }}" width="1200" height="1600">
              {%- else -%}
                {{ img | image_url: width: 800 | image_tag: widths: '300, 400, 600, 800', sizes: '(max-width: 640px) 50vw, (max-width: 1024px) 33vw, 25vw', alt: alt_text, class: 'jt:absolute jt:inset-0 jt:h-full jt:w-full jt:object-cover jt:transition-transform jt:duration-500 jt:group-hover:scale-105', loading: img_loading }}
              {%- endif -%}
              <div class="jt:absolute jt:inset-0 jt:bg-black/0 jt:transition-colors jt:duration-300 jt:group-hover:bg-black/10"></div>
            </button>
          {%- endif -%}
        {%- endfor -%}
      </div>
      <p class="jt:py-20 jt:text-center jt:text-sm jt:text-charcoal/40" data-jt-gempty hidden>No photos in this category yet.</p>
    </div>
  </section>

  <div class="jt-lightbox jt:fixed jt:inset-0 jt:z-[100] jt:flex-col jt:bg-black/95" data-jt-lightbox hidden role="dialog" aria-modal="true" aria-label="Photo viewer">
    <button type="button" data-jt-lclose aria-label="Close" class="jt:absolute jt:top-5 jt:right-5 jt:z-10 jt:flex jt:h-11 jt:w-11 jt:items-center jt:justify-center jt:rounded-full jt:bg-white/10 jt:text-white jt:transition-colors jt:hover:bg-white/20 jt:sm:top-8 jt:sm:right-8">{% render 'jt-icon', name: 'x', size: 20 %}</button>
    <button type="button" data-jt-lprev aria-label="Previous photo" class="jt:absolute jt:top-1/2 jt:left-2 jt:z-10 jt:flex jt:h-11 jt:w-11 jt:-translate-y-1/2 jt:items-center jt:justify-center jt:rounded-full jt:bg-white/10 jt:text-white jt:transition-colors jt:hover:bg-white/20 jt:sm:left-6">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
    </button>
    <button type="button" data-jt-lnext aria-label="Next photo" class="jt:absolute jt:top-1/2 jt:right-2 jt:z-10 jt:flex jt:h-11 jt:w-11 jt:-translate-y-1/2 jt:items-center jt:justify-center jt:rounded-full jt:bg-white/10 jt:text-white jt:transition-colors jt:hover:bg-white/20 jt:sm:right-6">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
    </button>
    <div class="jt:flex jt:flex-1 jt:items-center jt:justify-center jt:p-4 jt:sm:p-12" data-jt-lstage>
      <div class="jt:relative jt:h-full jt:w-full jt:max-w-4xl"><img src="" alt="JANKS Tailoring gallery photo" width="1200" height="1600" class="jt:absolute jt:inset-0 jt:h-full jt:w-full jt:object-contain" data-jt-limg></div>
    </div>
    <div class="jt:shrink-0 jt:px-6 jt:pb-6 jt:text-center jt:sm:pb-8">
      <p class="jt:text-sm jt:tracking-wide jt:text-cream" data-jt-lcap></p>
      <p class="jt:mt-1 jt:text-[10px] jt:uppercase jt:tracking-[0.2em] jt:text-white/30" data-jt-lcount></p>
    </div>
  </div>
</div>

<script>
  (function () {
    var root = document.querySelector('[data-jt-gallery-page]');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';
    var items = [].slice.call(root.querySelectorAll('[data-jt-gitem]'));
    var filters = root.querySelectorAll('[data-jt-gfilter]');
    var empty = root.querySelector('[data-jt-gempty]');
    var box = root.querySelector('[data-jt-lightbox]');
    var img = root.querySelector('[data-jt-limg]');
    var cap = root.querySelector('[data-jt-lcap]');
    var count = root.querySelector('[data-jt-lcount]');
    var active = 'all', list = [], idx = 0, startX = null;

    function visible() { return items.filter(function (i) { return !i.hidden; }); }
    function applyFilter(c) {
      active = c;
      items.forEach(function (i) { i.hidden = !(c === 'all' || i.getAttribute('data-cat') === c); });
      filters.forEach(function (f) { f.classList.toggle('is-active', f.getAttribute('data-jt-gfilter') === c); });
      empty.hidden = visible().length > 0;
    }
    filters.forEach(function (f) { f.addEventListener('click', function () { applyFilter(f.getAttribute('data-jt-gfilter')); }); });

    function show(n) {
      idx = (n + list.length) % list.length;
      var el = list[idx];
      img.src = el.getAttribute('data-full');
      img.alt = el.getAttribute('data-alt');
      cap.textContent = el.getAttribute('data-alt');
      count.textContent = (idx + 1) + ' / ' + list.length;
    }
    function open(el) { list = visible(); box.hidden = false; document.documentElement.classList.add('jt-lock'); show(list.indexOf(el)); }
    function close() { box.hidden = true; document.documentElement.classList.remove('jt-lock'); img.src = ''; }
    items.forEach(function (el) { el.addEventListener('click', function () { open(el); }); });
    root.querySelector('[data-jt-lclose]').addEventListener('click', function (e) { e.stopPropagation(); close(); });
    root.querySelector('[data-jt-lprev]').addEventListener('click', function (e) { e.stopPropagation(); show(idx - 1); });
    root.querySelector('[data-jt-lnext]').addEventListener('click', function (e) { e.stopPropagation(); show(idx + 1); });
    box.addEventListener('click', close);
    root.querySelector('[data-jt-lstage]').addEventListener('click', function (e) { e.stopPropagation(); });
    box.addEventListener('touchstart', function (e) { startX = e.touches[0].clientX; }, { passive: true });
    box.addEventListener('touchend', function (e) {
      if (startX === null) return;
      var d = e.changedTouches[0].clientX - startX;
      if (Math.abs(d) > 50) show(d < 0 ? idx + 1 : idx - 1);
      startX = null;
    });
    document.addEventListener('keydown', function (e) {
      if (box.hidden) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowRight') show(idx + 1);
      if (e.key === 'ArrowLeft') show(idx - 1);
    });
  })();
</script>

{% schema %}
{
  "name": "JANKS Gallery page",
  "class": "jt-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Portfolio" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Gallery" },
    { "type": "textarea", "id": "text", "label": "Intro", "default": "A closer look at the garments we make — from cloth and construction to the moments they were made for." }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "filename", "label": "…or file name from Settings → Files", "info": "Used when no photo is picked, e.g. garment-01.jpg" },
        { "type": "text", "id": "alt", "label": "Description" },
        { "type": "text", "id": "category", "label": "Category", "default": "garments", "info": "Photos with the same category share a filter tab." }
      ]
    }
  ],
  "max_blocks": 50,
  "presets": [{ "name": "JANKS Gallery page" }]
}
{% endschema %}
