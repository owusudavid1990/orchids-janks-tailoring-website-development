{%- comment -%} About page: long-form story with floated photos, a founder note, values and a closing CTA (reference: /about). {%- endcomment -%}
{%- liquid
  assign book_url = section.settings.cta_url | default: 'https://jankstailoring.com/book'
  assign img_index = 0
-%}
<div class="jt">
  <section class="jt:min-h-screen">
    <div class="jt:mx-auto jt:max-w-5xl jt:px-6 jt:py-20 jt:text-justify jt:lg:px-16 jt:lg:py-32 jt:lg:pt-40 jt:xl:px-24">

      <div class="jt-reveal">
        <span class="jt:mb-4 jt:block jt:text-[11px] jt:uppercase jt:tracking-[0.2em] jt:text-charcoal/40">{{ section.settings.eyebrow }}</span>
        <h1 class="jt:mb-8 jt:font-cinzel jt:text-4xl jt:leading-[1.1] jt:text-charcoal jt:lg:text-5xl">{{ section.settings.heading }}</h1>

        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'paragraph' -%}
              <p class="jt:mb-6 jt:text-sm jt:leading-relaxed jt:text-charcoal/50{% if block.settings.emphasis %} jt:font-medium jt:italic{% endif %}" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
            {%- when 'image' -%}
              {%- assign img_index = img_index | plus: 1 -%}
              {%- liquid
                assign fb = 'jt-about-1.jpg'
                if img_index == 2
                  assign fb = 'jt-about-2.jpg'
                elsif img_index >= 3
                  assign fb = 'jt-about-3.jpg'
                endif
                assign img_class = 'jt:h-auto jt:w-full jt:object-cover'
                if block.settings.square
                  assign img_class = 'jt:absolute jt:inset-0 jt:h-full jt:w-full jt:object-cover'
                endif
              -%}
              <div class="jt:relative jt:mb-4 jt:w-full jt:overflow-hidden jt:sm:w-[45%] jt:lg:w-[40%] {% if block.settings.side == 'right' %}jt:float-right jt:ml-6{% else %}jt:float-left jt:mr-6{% endif %}{% if block.settings.square %} jt:aspect-square{% endif %}" {{ block.shopify_attributes }}>
                {%- render 'jt-img', image: block.settings.image, fallback: fb, alt: block.settings.alt, class: img_class, sizes: '(max-width: 640px) 100vw, 40vw', max: 1200, w: 1120, h: 1400 -%}
              </div>
            {%- when 'clear' -%}
              <div class="jt:clear-both" {{ block.shopify_attributes }}></div>
          {%- endcase -%}
        {%- endfor -%}
        <div class="jt:clear-both"></div>
      </div>

      <div class="jt-reveal jt:mt-20 jt:max-w-lg jt:lg:mt-28" style="--jt-delay: .2s">
        <span class="jt:mb-4 jt:block jt:text-[11px] jt:uppercase jt:tracking-[0.2em] jt:text-charcoal/40">{{ section.settings.journey_eyebrow }}</span>
        <h2 class="jt:mb-6 jt:font-cinzel jt:text-2xl jt:leading-[1.15] jt:text-charcoal jt:lg:h-[34px] jt:lg:w-[862px] jt:lg:text-3xl">{{ section.settings.journey_heading }}</h2>
        <p class="jt:mb-8 jt:text-justify jt:text-sm jt:leading-relaxed jt:text-charcoal/50 jt:lg:h-[220px] jt:lg:w-[895px]">{{ section.settings.journey_text }}</p>
        <div class="jt:flex jt:items-center jt:gap-4">
          <div class="jt:h-14 jt:w-14 jt:overflow-hidden jt:bg-charcoal/5">
            {%- render 'jt-img', image: section.settings.founder_photo, fallback: 'jt-founder.jpg', alt: 'Founder', class: 'jt:h-full jt:w-full jt:object-cover', sizes: '56px', max: 300 -%}
          </div>
          <div>
            <p class="jt:font-cinzel jt:text-sm jt:text-charcoal">{{ section.settings.founder_name }}</p>
            <p class="jt:text-xs jt:text-charcoal/40">{{ section.settings.founder_role }}</p>
          </div>
        </div>
      </div>

      <div class="jt-reveal jt:mt-20 jt:max-w-lg jt:lg:mt-28" style="--jt-delay: .3s">
        <span class="jt:mb-4 jt:block jt:text-[11px] jt:uppercase jt:tracking-[0.2em] jt:text-charcoal/40">{{ section.settings.values_eyebrow }}</span>
        <h2 class="jt:mb-8 jt:font-cinzel jt:text-2xl jt:text-charcoal jt:lg:text-3xl">{{ section.settings.values_heading }}</h2>
        <div class="jt:space-y-6">
          {%- assign vi = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'value' -%}
              {%- assign vi = vi | plus: 1 -%}
              <div class="jt:flex jt:gap-4" {{ block.shopify_attributes }}>
                <span class="jt:text-sm jt:text-charcoal/20">0{{ vi }}</span>
                <div>
                  <h3 class="jt:mb-1 jt:font-cinzel jt:text-base jt:text-charcoal">{{ block.settings.title }}</h3>
                  <p class="jt:text-sm jt:leading-relaxed jt:text-charcoal/50">{{ block.settings.text }}</p>
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      <div class="jt-reveal jt:mt-20 jt:max-w-lg jt:border-t jt:border-charcoal/10 jt:pt-12 jt:lg:mt-28" style="--jt-delay: .4s">
        <h2 class="jt:mb-4 jt:font-cinzel jt:text-xl jt:text-charcoal">{{ section.settings.cta_heading }}</h2>
        <p class="jt:mb-6 jt:text-sm jt:text-charcoal/50">{{ section.settings.cta_text }}</p>
        <a href="{{ book_url }}" class="jt:inline-flex jt:items-center jt:gap-3 jt:bg-charcoal jt:px-6 jt:py-3 jt:text-[11px] jt:uppercase jt:tracking-[0.2em] jt:text-cream jt:transition-opacity jt:hover:opacity-90">
          {{ section.settings.cta_label }} {% render 'jt-icon', name: 'arrow-right', size: 14 %}
        </a>
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "JANKS About page",
  "class": "jt-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our Story" },
    { "type": "text", "id": "heading", "label": "Page heading", "default": "The Art of Tailoring" },
    { "type": "header", "content": "Founder note" },
    { "type": "text", "id": "journey_eyebrow", "label": "Eyebrow", "default": "A Personal Journey" },
    { "type": "text", "id": "journey_heading", "label": "Heading", "default": "Where tradition meets innovation" },
    { "type": "textarea", "id": "journey_text", "label": "Text" },
    { "type": "image_picker", "id": "founder_photo", "label": "Founder photo" },
    { "type": "text", "id": "founder_name", "label": "Founder name", "default": "Kwaku Acheampong" },
    { "type": "text", "id": "founder_role", "label": "Founder role", "default": "Founder & Master Tailor" },
    { "type": "header", "content": "Values" },
    { "type": "text", "id": "values_eyebrow", "label": "Eyebrow", "default": "Our Values" },
    { "type": "text", "id": "values_heading", "label": "Heading", "default": "What guides us" },
    { "type": "header", "content": "Closing call to action" },
    { "type": "text", "id": "cta_heading", "label": "Heading", "default": "Begin Your Journey" },
    { "type": "textarea", "id": "cta_text", "label": "Text", "default": "Experience the JANKS difference. Book a consultation and discover what bespoke tailoring truly means." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Book Consultation" },
    { "type": "url", "id": "cta_url", "label": "Button link", "info": "Leave empty to use https://jankstailoring.com/book" }
  ],
  "blocks": [
    {
      "type": "paragraph",
      "name": "Story paragraph",
      "settings": [
        { "type": "textarea", "id": "text", "label": "Text" },
        { "type": "checkbox", "id": "emphasis", "label": "Italic emphasis", "default": false }
      ]
    },
    {
      "type": "image",
      "name": "Floated photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo", "info": "Leave empty to use the built-in reference photo for this position." },
        { "type": "text", "id": "alt", "label": "Description" },
        { "type": "select", "id": "side", "label": "Side", "options": [{ "value": "left", "label": "Left" }, { "value": "right", "label": "Right" }], "default": "left" },
        { "type": "checkbox", "id": "square", "label": "Crop to a square", "default": false }
      ]
    },
    { "type": "clear", "name": "Clear floats", "settings": [] },
    {
      "type": "value",
      "name": "Value",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [{ "name": "JANKS About page" }]
}
{% endschema %}
