{%- comment -%} "Join the JANKS Family" — gold mailing-list band (reference: HomeClient mailing list). Uses Shopify's customer form (subscribes the address to email marketing). {%- endcomment -%}
<section class="jt jt:bg-gold jt:py-14 jt:lg:py-[4.5rem]">
  <div class="jt:mx-auto jt:max-w-7xl jt:px-6 jt:lg:px-12">
    <div class="jt:flex jt:flex-col jt:gap-8 jt:lg:flex-row jt:lg:items-center jt:lg:justify-between">

      <div class="jt:lg:max-w-md">
        <span class="jt:mb-2 jt:block jt:text-[11px] jt:uppercase jt:tracking-[0.3em] jt:text-charcoal/60">{{ section.settings.eyebrow }}</span>
        <h2 class="jt:font-cinzel jt:text-2xl jt:leading-tight jt:text-charcoal jt:lg:text-3xl">{{ section.settings.heading }}</h2>
        <p class="jt:mt-3 jt:text-sm jt:leading-relaxed jt:text-charcoal/60">{{ section.settings.text }}</p>
      </div>

      {%- form 'customer', id: 'jt-newsletter', class: 'jt:flex jt:flex-col jt:gap-3 jt:sm:flex-row jt:lg:min-w-[440px]' -%}
        {%- if form.posted_successfully? -%}
          <div class="jt:flex jt:items-center jt:gap-3 jt:border jt:border-charcoal/20 jt:px-6 jt:py-4 jt:lg:min-w-[440px]" role="status">
            {% render 'jt-icon', name: 'check', size: 16, class: 'jt:shrink-0 jt:text-charcoal' %}
            <p class="jt:text-sm jt:text-charcoal">You're on the list. Welcome to the JANKS family.</p>
          </div>
        {%- else -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <input type="email" name="contact[email]" required placeholder="Your email address" aria-label="Your email address" autocomplete="email" class="jt:flex-1 jt:border jt:border-charcoal/20 jt:bg-white/30 jt:px-5 jt:py-3.5 jt:font-cinzel jt:text-sm jt:text-charcoal jt:transition-colors jt:placeholder:text-charcoal/50 jt:focus:border-charcoal jt:focus:outline-none">
          <button type="submit" class="jt:inline-flex jt:items-center jt:justify-center jt:gap-2 jt:bg-charcoal jt:px-7 jt:py-3.5 jt:text-[11px] jt:uppercase jt:tracking-[0.25em] jt:whitespace-nowrap jt:text-cream jt:transition-colors jt:duration-300 jt:hover:bg-black">
            {{ section.settings.button_label }} {% render 'jt-icon', name: 'arrow-right', size: 12 %}
          </button>
        {%- endif -%}
      {%- endform -%}

    </div>
    <p class="jt:mt-6 jt:text-[10px] jt:tracking-wide jt:text-charcoal/40">{{ section.settings.fine_print }}</p>
  </div>
</section>

{% schema %}
{
  "name": "JANKS Newsletter",
  "class": "jt-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Stay Informed" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join the JANKS Family" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Style notes, fabric stories, and early access to new commissions — delivered once a month, never more." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe" },
    { "type": "text", "id": "fine_print", "label": "Fine print", "default": "No spam. Unsubscribe at any time. We respect your privacy." }
  ],
  "presets": [{ "name": "JANKS Newsletter" }]
}
{% endschema %}
