{%- comment -%}
  Floating extras from the reference site: the WhatsApp chat button (bottom right) and the "15% off your first order" popup.
  The popup appears after the visitor has scrolled ~60% of a screen or been on the page for 20 seconds (never on arrival), once per browser.
{%- endcomment -%}
{%- liquid
  assign wa = section.settings.whatsapp | replace: '+', '' | replace: ' ', ''
  assign promo_url = section.settings.popup_button_url | default: routes.collections_url
-%}
<div class="jt" data-jt-widgets>
  {%- if wa != blank -%}
    <a href="https://wa.me/{{ wa }}" target="_blank" rel="noopener noreferrer" aria-label="Chat on WhatsApp" class="jt:fixed jt:right-6 jt:bottom-6 jt:z-[45] jt:flex jt:h-14 jt:w-14 jt:items-center jt:justify-center jt:rounded-full jt:bg-[#25D366] jt:text-white jt:shadow-lg jt:transition-all jt:duration-300 jt:hover:scale-110 jt:hover:bg-[#20bd5a]">
      <svg viewBox="0 0 24 24" fill="currentColor" class="jt:h-7 jt:w-7" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
    </a>
  {%- endif -%}

  {%- if section.settings.popup_enabled -%}
    <div class="jt-popup jt:fixed jt:inset-0 jt:z-[95] jt:bg-black/60 jt:p-4 jt:backdrop-blur-sm" data-jt-popup data-code="{{ section.settings.popup_code }}" hidden>
      <div class="jt-popup__card jt:relative jt:flex jt:w-full jt:max-w-2xl jt:flex-col jt:overflow-hidden jt:bg-cream jt:shadow-2xl jt:sm:flex-row" role="dialog" aria-modal="true" aria-label="{{ section.settings.popup_heading | escape }}">
        <button type="button" data-jt-popup-close aria-label="Close" class="jt:group jt:absolute jt:top-4 jt:right-4 jt:z-10 jt:flex jt:h-9 jt:w-9 jt:items-center jt:justify-center jt:border jt:border-charcoal/20 jt:bg-cream/80 jt:transition-all jt:duration-200 jt:hover:bg-charcoal">
          {% render 'jt-icon', name: 'x', size: 14, class: 'jt:text-charcoal jt:transition-colors jt:group-hover:text-cream' %}
        </button>

        <div class="jt:relative jt:aspect-[4/3] jt:w-full jt:shrink-0 jt:bg-charcoal/5 jt:sm:aspect-auto jt:sm:w-2/5">
          {%- render 'jt-img', image: section.settings.popup_image, fallback: 'jt-cufflink-collection.webp', alt: 'JANKS Tailoring accessories', class: 'jt:absolute jt:inset-0 jt:h-full jt:w-full jt:object-cover', sizes: '(max-width: 640px) 100vw, 40vw', max: 900 -%}
        </div>

        <div class="jt:flex jt:flex-1 jt:flex-col jt:justify-center jt:p-8 jt:sm:p-10">
          <span class="jt:mb-3 jt:block jt:text-[10px] jt:uppercase jt:tracking-[0.3em] jt:text-gold">{{ section.settings.popup_eyebrow }}</span>
          <h2 class="jt:mb-3 jt:font-cinzel jt:text-2xl jt:leading-snug jt:text-charcoal jt:sm:text-3xl">{{ section.settings.popup_heading }}</h2>
          <p class="jt:mb-6 jt:text-sm jt:leading-relaxed jt:text-charcoal/60">{{ section.settings.popup_text }}</p>

          <button type="button" data-jt-popup-copy class="jt:group jt:mb-6 jt:flex jt:w-full jt:items-center jt:justify-between jt:border jt:border-dashed jt:border-charcoal/30 jt:px-4 jt:py-3 jt:transition-colors jt:hover:border-charcoal/50">
            <span class="jt:font-cinzel jt:text-base jt:tracking-[0.15em] jt:text-charcoal">{{ section.settings.popup_code }}</span>
            <span class="jt:flex jt:items-center jt:gap-1.5 jt:text-[10px] jt:uppercase jt:tracking-[0.15em] jt:text-charcoal/50 jt:transition-colors jt:group-hover:text-charcoal" data-jt-popup-copy-label>
              <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
              <span data-jt-popup-copy-text>Copy</span>
            </span>
          </button>

          <a href="{{ promo_url }}" data-jt-popup-close class="jt:flex jt:w-full jt:items-center jt:justify-center jt:bg-charcoal jt:py-4 jt:text-[10px] jt:uppercase jt:tracking-[0.25em] jt:text-cream jt:transition-all jt:duration-300 jt:hover:bg-gold jt:hover:text-charcoal">{{ section.settings.popup_button_label }}</a>
        </div>
      </div>
    </div>
  {%- endif -%}
</div>

{%- if section.settings.popup_enabled and request.design_mode == false -%}
  <script>
    (function () {
      var root = document.querySelector('[data-jt-popup]');
      if (!root) return;
      var KEY = 'janks-promo-' + (root.getAttribute('data-code') || 'welcome').toLowerCase() + '-dismissed';
      try { if (localStorage.getItem(KEY)) return; } catch (e) {}
      var done = false, timer;
      function onScroll() { if (window.scrollY > window.innerHeight * 0.6) show(); }
      function cleanup() { window.removeEventListener('scroll', onScroll); clearTimeout(timer); }
      function show() {
        if (done) return; done = true; cleanup();
        root.hidden = false;
        requestAnimationFrame(function () { root.classList.add('is-open'); });
      }
      function dismiss() {
        root.classList.remove('is-open');
        setTimeout(function () { root.hidden = true; }, 250);
        try { localStorage.setItem(KEY, '1'); } catch (e) {}
      }
      window.addEventListener('scroll', onScroll, { passive: true });
      timer = setTimeout(show, 20000);
      root.addEventListener('click', function (e) { if (e.target === root) dismiss(); });
      root.querySelectorAll('[data-jt-popup-close]').forEach(function (b) { b.addEventListener('click', dismiss); });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !root.hidden) dismiss(); });
      var copy = root.querySelector('[data-jt-popup-copy]');
      var label = root.querySelector('[data-jt-popup-copy-text]');
      copy.addEventListener('click', function () {
        var code = root.getAttribute('data-code');
        var ok = function () { label.textContent = 'Copied'; setTimeout(function () { label.textContent = 'Copy'; }, 2000); };
        if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(code).then(ok, function () {});
      });
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "JANKS Floating Widgets",
  "class": "jt-widgets-section",
  "settings": [
    { "type": "header", "content": "WhatsApp button" },
    { "type": "text", "id": "whatsapp", "label": "WhatsApp number (with country code)", "default": "447565533096", "info": "Leave empty to hide the button." },
    { "type": "header", "content": "Welcome popup" },
    { "type": "checkbox", "id": "popup_enabled", "label": "Show welcome popup", "default": true },
    { "type": "image_picker", "id": "popup_image", "label": "Popup image" },
    { "type": "text", "id": "popup_eyebrow", "label": "Eyebrow", "default": "Welcome to JANKS" },
    { "type": "text", "id": "popup_heading", "label": "Heading", "default": "15% Off Your First Order" },
    { "type": "textarea", "id": "popup_text", "label": "Text", "default": "Ties, cufflinks, and pocket squares — ready to ship." },
    { "type": "text", "id": "popup_code", "label": "Discount code", "default": "WELCOME15", "info": "Must exist under Discounts in the Shopify admin." },
    { "type": "text", "id": "popup_button_label", "label": "Button label", "default": "Shop Now" },
    { "type": "url", "id": "popup_button_url", "label": "Button link" }
  ],
  "presets": [{ "name": "JANKS Floating Widgets" }]
}
{% endschema %}
