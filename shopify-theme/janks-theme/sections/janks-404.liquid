{%- comment -%} "Page not found" in the JANKS style. {%- endcomment -%}
<div class="jt">
  <section class="jt:flex jt:min-h-[80vh] jt:items-center jt:bg-charcoal jt:pt-32 jt:pb-20">
    <div class="jt:mx-auto jt:max-w-3xl jt:px-6 jt:text-center jt:lg:px-12">
      <span class="jt:mb-6 jt:block jt:text-[11px] jt:uppercase jt:tracking-[0.3em] jt:text-gold">{{ section.settings.eyebrow }}</span>
      <h1 class="jt:mb-6 jt:font-cinzel jt:text-5xl jt:leading-[1.05] jt:text-cream jt:lg:text-7xl">{{ section.settings.heading }}</h1>
      <p class="jt:mx-auto jt:mb-10 jt:max-w-md jt:leading-relaxed jt:text-cream/60">{{ section.settings.text }}</p>
      <div class="jt:flex jt:flex-wrap jt:items-center jt:justify-center jt:gap-4">
        <a href="{{ routes.root_url }}" class="jt:inline-flex jt:items-center jt:gap-3 jt:bg-gold jt:px-8 jt:py-4 jt:text-[11px] jt:uppercase jt:tracking-[0.25em] jt:text-charcoal jt:transition-colors jt:duration-300 jt:hover:bg-cream">{{ section.settings.button_label }} {% render 'jt-icon', name: 'arrow-right', size: 13 %}</a>
        <a href="{{ routes.collections_url }}" class="jt:inline-flex jt:items-center jt:gap-3 jt:border jt:border-cream/20 jt:px-8 jt:py-4 jt:text-[11px] jt:uppercase jt:tracking-[0.25em] jt:text-cream jt:transition-all jt:duration-300 jt:hover:border-gold jt:hover:text-gold">Shop the Collection</a>
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "JANKS 404",
  "class": "jt-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Error 404" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Page not found" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "The page you are looking for has been moved or no longer exists. Let us take you back to something well made." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Back to Home" }
  ]
}
{% endschema %}
