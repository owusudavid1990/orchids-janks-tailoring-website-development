{%- comment -%} "Our Process" / "The Making": tabbed hero for three services with an alternating step timeline (reference: /work). {%- endcomment -%}
{%- liquid
  assign services = section.blocks | where: 'type', 'service'
  assign book_url = section.settings.book_url | default: 'https://jankstailoring.com/book'
-%}
<div class="jt" data-jt-process>

  <section class="jt:relative jt:h-[60vh] jt:lg:h-[80vh]">
    {%- for block in services -%}
      {%- liquid
        case forloop.index
          when 1
            assign hero_fb = 'jt-work-bespoke-hero.jpg'
          when 2
            assign hero_fb = 'jt-work-mtm-hero.jpeg'
          else
            assign hero_fb = 'jt-work-alterations-hero.jpeg'
        endcase
        assign hero_loading = 'lazy'
        assign hero_priority = 'auto'
        if forloop.first
          assign hero_loading = 'eager'
          assign hero_priority = 'high'
        endif
      -%}
      <div class="jt-pslide jt:absolute jt:inset-0{% if forloop.first %} is-active{% endif %}" data-jt-pslide="{{ forloop.index0 }}">
        {%- render 'jt-img', image: block.settings.hero_image, fallback: hero_fb, alt: block.settings.title, class: 'jt:absolute jt:inset-0 jt:h-full jt:w-full jt:object-cover', sizes: '100vw', loading: hero_loading, priority: hero_priority, max: 2400 -%}
        <div class="jt:absolute jt:inset-0 jt:bg-gradient-to-b jt:from-black/40 jt:via-black/20 jt:to-black/80"></div>
      </div>
    {%- endfor -%}

    <div class="jt:absolute jt:inset-0 jt:mx-auto jt:flex jt:w-full jt:max-w-full jt:flex-col jt:justify-end jt:px-6 jt:pb-12 jt:lg:h-[863px] jt:lg:px-12 jt:lg:pb-20">
      <div class="jt-reveal">
        <span class="jt:mb-3 jt:block jt:text-[11px] jt:uppercase jt:tracking-[0.2em] jt:text-cream/50">{{ section.settings.eyebrow }}</span>
        <h1 class="jt:font-cinzel jt:text-4xl jt:leading-[1.1] jt:text-cream jt:lg:text-6xl">{{ section.settings.heading }}</h1>
      </div>
    </div>

    <div class="jt:absolute jt:right-0 jt:bottom-0 jt:left-0 jt:border-t jt:border-cream/10">
      <div class="jt:mx-auto jt:max-w-7xl jt:px-6 jt:lg:px-12">
        <div class="jt:flex" role="tablist">
          {%- for block in services -%}
            <button type="button" role="tab" data-jt-ptab="{{ forloop.index0 }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" class="jt-ptab jt:relative jt:flex-1 jt:py-4 jt:text-center jt:transition-all{% if forloop.first %} is-active{% endif %}">
              <span class="jt:text-[10px] jt:uppercase jt:tracking-[0.15em] jt:lg:text-[11px]">{{ block.settings.title }}</span>
              <span class="jt-ptab__bar jt:absolute jt:right-0 jt:bottom-0 jt:left-0 jt:h-px jt:bg-cream"></span>
            </button>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </section>

  {%- for block in services -%}
    {%- liquid
      assign steps = block.settings.steps | newline_to_br | split: '<br />'
      case forloop.index
        when 1
          assign f1 = 'jt-work-consultation.jpeg' | append: ',jt-work-measurements.jpeg,jt-work-pattern-cutting.jpeg,jt-work-first-fitting.jpeg,jt-work-construction.jpeg,jt-work-final-fitting.webp'
        when 2
          assign f1 = 'jt-work-style-selection.jpeg' | append: ',jt-work-fabric-details.jpeg,jt-work-mtm-measurement.jpeg,jt-work-construction.jpeg,jt-work-fitting-marking.jpeg'
        else
          assign f1 = 'jt-fabric-swatches.jpeg' | append: ',jt-work-fitting-marking.jpeg,jt-work-alteration.jpeg,jt-work-final-review.webp'
      endcase
      assign fallbacks = f1 | split: ','
    -%}
    <section class="jt-ppanel jt:py-20 jt:lg:py-28{% unless forloop.first %}{% endunless %}" data-jt-ppanel="{{ forloop.index0 }}"{% unless forloop.first %} hidden{% endunless %} {{ block.shopify_attributes }}>
      <div class="jt:mx-auto jt:max-w-7xl jt:px-6 jt:lg:px-12">
        <div class="jt:mb-16 jt:max-w-2xl">
          <h2 class="jt:mb-4 jt:font-cinzel jt:text-2xl jt:text-charcoal jt:lg:text-3xl">{{ block.settings.title }}</h2>
          <p class="jt:text-sm jt:leading-relaxed jt:text-charcoal/50">{{ block.settings.intro }}</p>
          <span class="jt:mt-4 jt:block jt:text-[11px] jt:uppercase jt:tracking-[0.15em] jt:text-charcoal/30">Timeline: {{ block.settings.duration }}</span>
        </div>

        <div class="jt:relative">
          <div class="jt:absolute jt:top-0 jt:bottom-0 jt:left-8 jt:w-px jt:bg-gradient-to-b jt:from-charcoal/5 jt:via-charcoal/20 jt:to-charcoal/5 jt:lg:left-1/2"></div>
          <div class="jt:space-y-16 jt:lg:space-y-24">
            {%- for line in steps -%}
              {%- assign parts = line | strip | split: '|' -%}
              {%- if parts.size >= 3 -%}
                {%- liquid
                  assign i = forloop.index0
                  assign rem = i | modulo: 2
                  assign img_key = 'image_' | append: forloop.index
                  assign step_image = block.settings[img_key]
                  assign step_fb = fallbacks[i]
                  assign step_alt = parts[0] | strip
                -%}
                <div class="jt-reveal {% if rem == 0 %}jt-reveal--left{% else %}jt-reveal--right{% endif %} jt:relative jt:grid jt:grid-cols-1 jt:items-center jt:gap-8 jt:lg:grid-cols-2 jt:lg:gap-16">
                  <div class="jt:absolute jt:top-1/2 jt:left-8 jt:z-10 jt:-translate-y-1/2 jt:lg:left-1/2 jt:lg:-translate-x-1/2">
                    <div class="jt:h-4 jt:w-4 jt:rounded-full jt:border-4 jt:border-cream jt:bg-charcoal"></div>
                  </div>
                  <div class="jt:pl-20 jt:lg:pl-0 {% if rem == 1 %}jt:lg:order-2 jt:lg:pl-16{% else %}jt:lg:pr-16 jt:lg:text-right{% endif %}">
                    <span class="jt:mb-2 jt:block jt:text-[10px] jt:uppercase jt:tracking-[0.2em] jt:text-charcoal/30">Step 0{{ forloop.index }} — {{ parts[1] | strip }}</span>
                    <h3 class="jt:mb-4 jt:font-cinzel jt:text-2xl jt:text-charcoal jt:lg:text-3xl">{{ parts[0] | strip }}</h3>
                    <p class="jt:leading-relaxed jt:text-charcoal/60">{{ parts[2] | strip }}</p>
                  </div>
                  <div class="jt:pl-20 jt:lg:pl-0 {% if rem == 1 %}jt:lg:order-1 jt:lg:pr-16{% else %}jt:lg:pl-16{% endif %}">
                    <div class="jt:group jt:relative jt:aspect-[4/3] jt:overflow-hidden jt:rounded-2xl">
                      {%- render 'jt-img', image: step_image, fallback: step_fb, alt: step_alt, class: 'jt:absolute jt:inset-0 jt:h-full jt:w-full jt:object-cover jt:transition-transform jt:duration-700 jt:group-hover:scale-105', sizes: '(max-width: 1024px) 100vw, 50vw' -%}
                      <div class="jt:absolute jt:inset-0 jt:bg-gradient-to-tr jt:from-charcoal/20 jt:to-transparent jt:opacity-0 jt:transition-opacity jt:duration-500 jt:group-hover:opacity-100"></div>
                    </div>
                  </div>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      </div>
    </section>
  {%- endfor -%}

  <section class="jt:border-t jt:border-charcoal/10 jt:py-20 jt:lg:py-28">
    <div class="jt:mx-auto jt:max-w-4xl jt:px-6 jt:text-center jt:lg:px-12">
      <div class="jt-reveal">
        <h2 class="jt:mb-4 jt:font-cinzel jt:text-3xl jt:text-charcoal jt:lg:text-4xl">{{ section.settings.cta_heading }}</h2>
        <p class="jt:mx-auto jt:mb-8 jt:max-w-md jt:text-sm jt:text-charcoal/50">{{ section.settings.cta_text }}</p>
        <a href="{{ book_url }}" class="jt:inline-flex jt:items-center jt:gap-3 jt:bg-charcoal jt:px-8 jt:py-4 jt:text-[11px] jt:uppercase jt:tracking-[0.2em] jt:text-cream jt:transition-opacity jt:hover:opacity-90">
          {{ section.settings.cta_label }} {% render 'jt-icon', name: 'arrow-right', size: 14 %}
        </a>
      </div>
    </div>
  </section>
</div>

<script>
  (function () {
    var root = document.querySelector('[data-jt-process]');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';
    var tabs = root.querySelectorAll('[data-jt-ptab]');
    var slides = root.querySelectorAll('[data-jt-pslide]');
    var panels = root.querySelectorAll('[data-jt-ppanel]');
    tabs.forEach(function (tab) {
      tab.addEventListener('click', function () {
        var n = tab.getAttribute('data-jt-ptab');
        tabs.forEach(function (t) { var on = t === tab; t.classList.toggle('is-active', on); t.setAttribute('aria-selected', on ? 'true' : 'false'); });
        slides.forEach(function (s) { s.classList.toggle('is-active', s.getAttribute('data-jt-pslide') === n); });
        panels.forEach(function (p) {
          var on = p.getAttribute('data-jt-ppanel') === n;
          p.hidden = !on;
          if (on) p.querySelectorAll('.jt-reveal').forEach(function (el) { el.classList.add('is-in'); });
        });
      });
    });
  })();
</script>

{% schema %}
{
  "name": "JANKS Process page",
  "class": "jt-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our Process" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Making" },
    { "type": "text", "id": "cta_heading", "label": "Closing heading", "default": "Ready to begin?" },
    { "type": "textarea", "id": "cta_text", "label": "Closing text", "default": "Book your consultation and experience the art of true tailoring." },
    { "type": "text", "id": "cta_label", "label": "Closing button label", "default": "Book Consultation" },
    { "type": "url", "id": "book_url", "label": "Booking link", "info": "Leave empty to use https://jankstailoring.com/book" }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Service tab",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "duration", "label": "Timeline" },
        { "type": "textarea", "id": "intro", "label": "Introduction" },
        { "type": "image_picker", "id": "hero_image", "label": "Hero image" },
        { "type": "textarea", "id": "steps", "label": "Steps", "info": "One step per line: Title | Duration | Description" },
        { "type": "image_picker", "id": "image_1", "label": "Step 1 image" },
        { "type": "image_picker", "id": "image_2", "label": "Step 2 image" },
        { "type": "image_picker", "id": "image_3", "label": "Step 3 image" },
        { "type": "image_picker", "id": "image_4", "label": "Step 4 image" },
        { "type": "image_picker", "id": "image_5", "label": "Step 5 image" },
        { "type": "image_picker", "id": "image_6", "label": "Step 6 image" }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [{ "name": "JANKS Process page" }]
}
{% endschema %}
